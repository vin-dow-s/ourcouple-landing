---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from '../../components/Icon.astro';
import ShareButtons from '../../components/tools/ShareButtons.astro';
import ToolAppCta from '../../components/ToolAppCta.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import decks from '../../data/spicy-truth-or-dare.json';

// Separate deck from /tools/truth-or-dare-couples on purpose.
//
// That page's "Spicy" level is deliberately mild ("nothing explicit, just
// playful and bold") because it has to work for a general audience landing on
// "truth or dare for couples". This page serves a different, more specific
// intent — "spicy couple games online free" converts at 19% CTR from position
// 4.8, and "spicy truth or dare" traffic wants a bolder deck than the parent
// can responsibly show by default.
//
// Sharing one deck between the two would recreate exactly the cannibalization
// that cost /tools/couple-quiz its ranking to the blog post: two pages, same
// content, Google picks one. Distinct decks + distinct framing keeps both.
const levels = ['warm', 'hot', 'fire'];
const counts = Object.fromEntries(
  levels.map((l) => [l, decks[l].truths.length + decks[l].dares.length])
);
const totalCount = Object.values(counts).reduce((a, b) => a + b, 0);

const levelMeta = {
  warm: { emoji: '🌶️', label: 'Warm' },
  hot: { emoji: '🔥', label: 'Hot' },
  fire: { emoji: '💥', label: 'Fire' },
};
---

<ToolLayout
  title="Spicy Truth or Dare for Couples — Free 18+ Game Online"
  description={`${totalCount} spicy truths and dares for couples, free and online. Three heat levels from flirty to bold — no signup, no app, just the two of you.`}
  canonicalPath="/tools/spicy-truth-or-dare"
  ctaHeading="Keep the good ones"
  ctaCopy="OurCouple gives you a private, encrypted space to save the moments worth remembering — plus daily questions, memories and games built for two."
  howTo={{
    name: 'How to play spicy Truth or Dare for couples',
    description: 'A free 18+ Truth or Dare game for couples, with three heat levels.',
    steps: [
      { name: 'Agree on limits first', text: 'Decide together what is on and off the table. Anyone can pass on any prompt, no explanation needed.' },
      { name: 'Pick a heat level', text: 'Start at Warm and move up to Hot or Fire when you are both ready.' },
      { name: 'Take turns', text: 'Tap Truth or Dare, pass the phone, and keep going. Nothing is saved to the page.' },
    ],
  }}
  faqs={[
    {
      question: 'Is this spicy Truth or Dare game free?',
      answer: 'Yes — completely free, no signup, no email and no in-app purchases. All three heat levels are unlocked from the start.',
    },
    {
      question: 'How is this different from your regular Truth or Dare game?',
      answer: 'Our main Truth or Dare for couples game is written for any audience and keeps things playful. This one is a separate 18+ deck with bolder prompts, built for a private night in. Different prompts, no overlap.',
    },
    {
      question: 'What are the three heat levels?',
      answer: `Warm is flirty and safe — fine anywhere. Hot is bolder and more personal, best kept private. Fire is the boldest end of the deck, for a night in with the door closed. There are ${counts.warm} Warm, ${counts.hot} Hot and ${counts.fire} Fire prompts.`,
    },
    {
      question: 'Can we play this long-distance?',
      answer: 'Yes. Open it on a video call and take turns reading prompts to each other. Several dares are written specifically for couples who are apart — voice notes, photos and messages.',
    },
    {
      question: 'Is it okay to skip a prompt?',
      answer: 'Always. The only rule that matters is that either of you can pass on anything, at any time, without needing a reason. Agree on your limits before you start and the game works the way it should.',
    },
    {
      question: 'Are the prompts explicit?',
      answer: 'They are suggestive rather than graphic. The deck is written for couples who want something bolder than a standard party game, without being crude.',
    },
  ]}
>
  <div class="max-w-2xl mx-auto px-4">
    <!-- Hero -->
    <div class="text-center mb-6 animate-fade-in">
      <div class="w-16 h-16 rounded-2xl bg-partner/10 flex items-center justify-center mx-auto mb-4">
        <Icon name="flame" class="w-8 h-8 text-partner" />
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-text tracking-tighter mb-3">
        Spicy Truth or Dare for Couples
      </h1>
      <p class="text-text-secondary max-w-md mx-auto">
        {totalCount} bold truths and dares across three heat levels. Free, online, no signup.
      </p>
    </div>

    <!-- 18+ notice. Sets expectations before the first tap and doubles as the
         on-page signal that this deck is intentionally separate. -->
    <div class="flex items-start gap-3 rounded-2xl border border-partner/25 bg-partner/5 p-4 mb-6 text-left">
      <span class="text-lg leading-none mt-0.5" aria-hidden="true">🔞</span>
      <p class="text-sm text-text-secondary leading-relaxed">
        <strong class="text-text">For couples, 18+.</strong> Agree on your limits before you
        start — either of you can pass on any prompt, no reason needed. Nothing you tap is
        stored or sent anywhere.
      </p>
    </div>

    <!-- Heat Selector -->
    <div class="grid grid-cols-3 gap-2 mb-3" id="level-selector" role="tablist" aria-label="Choose heat level">
      {levels.map((level, i) => (
        <button
          type="button"
          class={`level-btn px-3 py-3 rounded-xl border-2 text-text font-semibold text-sm transition-all ${
            i === 0 ? 'border-partner bg-partner/10' : 'border-border bg-card hover:border-partner/30'
          }`}
          data-level={level}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          <span class="block text-xl mb-0.5">{levelMeta[level].emoji}</span>
          {levelMeta[level].label}
        </button>
      ))}
    </div>
    <p id="level-blurb" class="text-center text-text-light text-xs mb-6">{decks.warm.blurb}</p>

    <!-- Card Display -->
    <div class="relative mb-6">
      <div
        id="prompt-card"
        class="bg-card rounded-3xl border border-border p-6 md:p-10 min-h-[180px] md:min-h-[260px] flex flex-col items-center justify-center text-center transition-all duration-300"
      >
        <p id="card-type" class="text-sm uppercase tracking-widest text-text-light mb-3 font-medium">
          Tap a button below
        </p>
        <p id="card-text" class="text-xl md:text-2xl font-semibold text-text leading-snug">
          Pick Truth or Dare to start
        </p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="grid grid-cols-2 gap-3 mb-6">
      <button
        type="button"
        id="truth-btn"
        class="px-6 py-4 btn-pink rounded-2xl font-bold text-lg transition-all hover:scale-[1.02] active:scale-95"
      >
        💭 Truth
      </button>
      <button
        type="button"
        id="dare-btn"
        class="px-6 py-4 bg-partner text-white rounded-2xl font-bold text-lg hover:bg-partner/90 transition-all hover:scale-[1.02] active:scale-95"
      >
        🔥 Dare
      </button>
    </div>

    <!-- Counter -->
    <p id="counter" class="text-center text-text-secondary text-sm mb-8">
      <span id="round-num">0</span> rounds played · Tap again for a new prompt
    </p>

    <!-- In-game CTA, revealed after ROUNDS_BEFORE_CTA rounds. Same reasoning as
         the parent game page: players stay in the loop and never scroll down. -->
    <div
      id="in-game-cta"
      hidden
      class="mb-10 rounded-2xl border border-primary/25 bg-gradient-to-br from-primary/10 to-partner/10 p-5 text-center"
    >
      <p class="text-base md:text-lg font-bold text-text mb-1">Enjoying this one?</p>
      <p class="text-sm text-text-secondary mb-4 max-w-sm mx-auto leading-relaxed">
        OurCouple keeps the moments worth remembering in one private, encrypted
        space — plus daily questions, memories and more games for two.
      </p>
      <StoreButtons placement="tool_in_game" size="sm" />
    </div>

    <!-- Share -->
    <div class="text-center mb-12">
      <ShareButtons
        title="Send this to your partner"
        text="Spicy Truth or Dare for couples — free, no signup:"
      />
    </div>

    <ToolAppCta
      kicker="Loved this?"
      heading="Everything else lives in the app"
      copy="Private messages, memories, daily questions and games — all in one encrypted space, just for the two of you."
    />

    <!-- Cross-sell -->
    <div class="bg-card rounded-2xl border border-border p-6 mb-12">
      <h2 class="text-lg font-semibold text-text mb-2">Want something gentler?</h2>
      <p class="text-text-secondary text-sm mb-4">
        Our original <a href="/tools/truth-or-dare-couples" class="text-primary hover:underline">Truth or Dare for couples</a>
        has a completely different set of prompts across Sweet, Playful and Spicy levels — good
        for a lighter mood or when you're not alone.
      </p>
      <p class="text-text-secondary text-sm">
        Also try <a href="/tools/never-have-i-ever" class="text-primary hover:underline">Never Have I Ever</a>,
        <a href="/tools/would-you-rather" class="text-primary hover:underline">Would You Rather</a>, or the
        <a href="/tools/couple-quiz" class="text-primary hover:underline">couple quiz</a>.
      </p>
    </div>

    <!-- SEO Body Content -->
    <article class="prose prose-sm max-w-none mb-12 space-y-4">
      <h2 class="text-xl font-semibold text-text tracking-tight">A spicy couple game you can play right now</h2>
      <p class="text-text-secondary leading-relaxed">
        Most spicy couple games online ask you to sign up, install something, or
        sit through ads before you get to a single prompt. This one doesn't. Open
        the page, pick a heat level, and start. There's nothing to create, nothing
        to download, and nothing you tap is stored or sent anywhere — the prompts
        are picked at random in your browser and disappear when you close the tab.
      </p>

      <h2 class="text-xl font-semibold text-text tracking-tight">Three heat levels, and why they matter</h2>
      <p class="text-text-secondary leading-relaxed">
        <strong>Warm</strong> is flirty and safe — the kind of thing you could play
        on a sofa with the curtains open. <strong>Hot</strong> gets more personal
        and works best when it's only the two of you. <strong>Fire</strong> is the
        boldest end of the deck, written for a private night in. Starting at Warm
        and moving up as you both get comfortable tends to work far better than
        opening at the top.
      </p>

      <h2 class="text-xl font-semibold text-text tracking-tight">One rule worth agreeing on first</h2>
      <p class="text-text-secondary leading-relaxed">
        Either of you can pass on anything, at any time, without giving a reason.
        That single rule is what makes a game like this fun rather than tense —
        it means a bold prompt is an invitation, not an obligation. Talk about
        where your limits are before the first tap, not after an awkward one.
      </p>

      <h2 class="text-xl font-semibold text-text tracking-tight">Playing long-distance</h2>
      <p class="text-text-secondary leading-relaxed">
        Open the game on a video call and take turns reading prompts out loud.
        Several of the dares — voice notes, photos, messages you'd only send to
        one person — were written specifically for couples who aren't in the same
        room. If you're apart often, our
        <a href="/tools/long-distance-bond" class="text-primary hover:underline">long-distance bond quiz</a>
        is worth a look too.
      </p>

      <h2 class="text-xl font-semibold text-text tracking-tight">Where the good ones go</h2>
      <p class="text-text-secondary leading-relaxed">
        A web page can't remember anything about you, which is the point — but it
        also means the best answers vanish when you close it. OurCouple is a
        private, encrypted space for two where the things worth keeping actually
        stay: memories, photos, love notes, daily questions, and games you play
        together over time.
      </p>
    </article>
  </div>

  <script define:vars={{ decks }}>
    let currentLevel = 'warm';
    let lastIndices = {
      warm: { truth: -1, dare: -1 },
      hot: { truth: -1, dare: -1 },
      fire: { truth: -1, dare: -1 },
    };
    let rounds = 0;

    const ROUNDS_BEFORE_CTA = 8;

    const inGameCta = document.getElementById('in-game-cta');
    const card = document.getElementById('prompt-card');
    const cardType = document.getElementById('card-type');
    const cardText = document.getElementById('card-text');
    const truthBtn = document.getElementById('truth-btn');
    const dareBtn = document.getElementById('dare-btn');
    const roundNum = document.getElementById('round-num');
    const levelBlurb = document.getElementById('level-blurb');
    const levelButtons = document.querySelectorAll('.level-btn');

    const levelStyle = {
      warm: { type: 'text-primary', classes: ['bg-primary/5', 'border-primary/30'] },
      hot: { type: 'text-partner', classes: ['bg-partner/10', 'border-partner/30'] },
      fire: { type: 'text-accent', classes: ['bg-accent/10', 'border-accent/40'] },
    };

    function pickPrompt(type) {
      const pool = decks[currentLevel][type === 'truth' ? 'truths' : 'dares'];
      let idx;
      // Avoid back-to-back repeat
      do {
        idx = Math.floor(Math.random() * pool.length);
      } while (pool.length > 1 && idx === lastIndices[currentLevel][type]);
      lastIndices[currentLevel][type] = idx;

      Object.values(levelStyle).forEach((s) => s.classes.forEach((c) => card.classList.remove(c)));
      card.classList.add(...levelStyle[currentLevel].classes);

      cardType.textContent = type === 'truth' ? '💭 Truth' : '🔥 Dare';
      cardType.className = `text-sm uppercase tracking-widest mb-3 font-medium ${levelStyle[currentLevel].type}`;

      card.style.transform = 'scale(0.96)';
      cardText.style.opacity = '0.4';
      setTimeout(() => {
        cardText.textContent = pool[idx];
        card.style.transform = 'scale(1)';
        cardText.style.opacity = '1';
      }, 120);

      rounds += 1;
      roundNum.textContent = rounds;

      if (rounds === ROUNDS_BEFORE_CTA && inGameCta) {
        inGameCta.hidden = false;
        if (window.posthog) {
          window.posthog.capture('spicy_truth_or_dare_cta_shown', { rounds });
        }
      }

      if (window.posthog) {
        window.posthog.capture('spicy_truth_or_dare_played', { level: currentLevel, type });
      }
    }

    truthBtn.addEventListener('click', () => pickPrompt('truth'));
    dareBtn.addEventListener('click', () => pickPrompt('dare'));

    levelButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const newLevel = btn.dataset.level;
        if (newLevel === currentLevel) return;
        currentLevel = newLevel;
        levelBlurb.textContent = decks[currentLevel].blurb;
        levelButtons.forEach((b) => {
          const active = b.dataset.level === currentLevel;
          b.classList.toggle('border-partner', active);
          b.classList.toggle('bg-partner/10', active);
          b.classList.toggle('border-border', !active);
          b.classList.toggle('bg-card', !active);
          b.setAttribute('aria-pressed', String(active));
        });
        if (window.posthog) {
          window.posthog.capture('spicy_truth_or_dare_level_changed', { level: currentLevel });
        }
      });
    });
  </script>
</ToolLayout>
