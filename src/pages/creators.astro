---
// Creator / ambassador program page. Tiers sit directly under the hero
// subtitle; the Apply CTA below them adapts to the selected tier. Commission
// is a ONE-TIME payout per new paying subscriber (simpler to run and to
// promise than lifetime recurring), computed on the yearly plan ($49.99)
// net of app-store fees (15% small-business rate):
//   net = 49.99 * 0.85 = 42.49  →  40% ≈ $17 · 20% ≈ $8 · 15% ≈ $6
// Attribution is code-based (in-app "creator code" at onboarding) because
// app-store installs break web cookie attribution.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Waves fill in order: while Founding spots remain, the lower tiers are shown
// locked — the offer on the table right now is the 40%. Flip this to false
// once the first 20 are taken and Partner becomes the live tier.
const FOUNDING_SPOTS_OPEN = true;

const tiers = [
  { id: "founding", name: "Founding Creator", rate: 40, earn: 17, highlight: true, note: "First 20 creators only", locked: false },
  { id: "partner", name: "Partner", rate: 20, earn: 8, highlight: false, note: "Next 20 creators", locked: FOUNDING_SPOTS_OPEN },
  { id: "affiliate", name: "Affiliate", rate: 15, earn: 6, highlight: false, note: "Open to everyone", locked: FOUNDING_SPOTS_OPEN },
];
---

<Layout
  title="OurCouple Creators — Earn up to 40% Sharing the Couple App"
  description="Join the OurCouple creator program: up to 40% commission per subscriber for content creators in the couples & relationship niche. Free to join, no follower minimum, monthly payouts."
  canonicalPath="/creators"
>
  <Header />

  <main class="flex-1">
    <!-- Hero + tiers + adaptive CTA -->
    <section class="pt-32 pb-20 bg-gradient-radial">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <span class="inline-block text-xs font-semibold uppercase tracking-wider text-primary-dark bg-primary/10 px-3 py-1 rounded-full mb-5">Creator program</span>
        <h1 class="tracking-tighter text-4xl md:text-6xl font-bold text-text mb-5">
          Get paid to talk about love
        </h1>
        <p class="text-text-secondary text-lg max-w-2xl mx-auto mb-10">
          You make content about relationships? Earn a commission on every subscriber
          you send to OurCouple.
        </p>

        <!-- Tiers (40% first) — click to select, the CTA below adapts -->
        <div class="grid sm:grid-cols-3 gap-4 mb-8 text-left" id="tier-cards">
          {tiers.map((tier, i) => (
            <button
              type="button"
              disabled={tier.locked}
              class={`tier-card relative rounded-2xl p-6 border text-center transition-all ${
                tier.locked
                  ? "border-border bg-card opacity-55 cursor-not-allowed"
                  : tier.highlight
                    ? "border-primary/50 bg-gradient-to-b from-primary/10 to-partner/5 shadow-lg shadow-primary/10 cursor-pointer"
                    : "border-border bg-card hover:border-primary/30 cursor-pointer"
              }`}
              data-rate={tier.rate}
              data-tier={tier.name}
              data-locked={tier.locked ? "true" : "false"}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {tier.highlight && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 btn-pink text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap">
                  First 20 only
                </span>
              )}
              <p class="font-semibold text-text mb-2 flex items-center justify-center gap-1.5">
                {tier.locked && (
                  <svg class="w-3.5 h-3.5 text-text-light shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                )}
                {tier.name}
              </p>
              <p class="text-5xl font-bold tracking-tighter text-text mb-1">{tier.rate}%</p>
              <p class={`font-semibold text-sm ${tier.locked ? "text-text-light" : "text-primary-dark"}`}>≈ ${tier.earn} per subscriber</p>
              <p class="text-text-light text-xs mt-2">{tier.note}</p>
            </button>
          ))}
        </div>

        <button
          type="button"
          id="apply-cta"
          class="apply-open btn-pink inline-flex items-center gap-2 px-7 py-3.5 rounded-xl font-semibold"
          data-cta-location="creators_hero"
          data-fast-goal="cta_creators_apply"
        >
          <span id="apply-cta-label">Apply — earn 40% per subscriber</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <p class="text-text-light text-xs mt-4 max-w-md mx-auto">
          One-time commission per new paying subscriber, based on the yearly plan ($49.99) after app-store fees.
          Free to join · No follower minimum.
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section class="py-20 bg-card">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="tracking-tighter text-3xl md:text-4xl font-bold text-center text-text mb-12">
          How it works
        </h2>
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-xl font-bold text-primary-dark">1</span>
            </div>
            <h3 class="font-semibold text-lg text-text mb-2">Apply & get your code</h3>
            <p class="text-text-secondary text-sm">Tell us where you post. If it's a fit, you get your personal creator code — that's all you need to start earning.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-xl font-bold text-primary-dark">2</span>
            </div>
            <h3 class="font-semibold text-lg text-text mb-2">Create & share</h3>
            <p class="text-text-secondary text-sm">Post about OurCouple however you want — couple vlogs, app tours, date-night content. Your audience enters your code in the app.</p>
          </div>
          <div>
            <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-xl font-bold text-primary-dark">3</span>
            </div>
            <h3 class="font-semibold text-lg text-text mb-2">Get paid monthly</h3>
            <p class="text-text-secondary text-sm">Every new subscriber with your code earns you a commission. Paid out monthly via PayPal or Wise.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 bg-background">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="tracking-tighter text-3xl md:text-4xl font-bold text-center text-text mb-12">
          Creator FAQ
        </h2>
        <div class="space-y-4">
          <details class="group bg-card border border-border rounded-2xl">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-text pr-4">How does tracking work if sales happen in the App Store?</h3>
              <svg class="w-5 h-5 text-text-secondary group-open:rotate-180 transition-transform flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-6 pb-6 text-text-secondary text-sm leading-relaxed">
              <p>You get a personal creator code. When someone you sent downloads OurCouple, they enter your code during onboarding ("Who sent you?") — every new subscription from that account is credited to you. No cookies, no lost attribution.</p>
            </div>
          </details>
          <details class="group bg-card border border-border rounded-2xl">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-text pr-4">How much can I actually earn?</h3>
              <svg class="w-5 h-5 text-text-secondary group-open:rotate-180 transition-transform flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-6 pb-6 text-text-secondary text-sm leading-relaxed">
              <p>At the Founding rate, every yearly subscriber is ≈ $17 in your pocket. 25 subscribers from one good video ≈ $425. 100 subscribers ≈ $1,700. Couples content converts well here — the app is literally made for your audience.</p>
            </div>
          </details>
          <details class="group bg-card border border-border rounded-2xl">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-text pr-4">How and when do I get paid?</h3>
              <svg class="w-5 h-5 text-text-secondary group-open:rotate-180 transition-transform flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-6 pb-6 text-text-secondary text-sm leading-relaxed">
              <p>Monthly, via PayPal or Wise, with a $25 minimum payout (balances roll over). Commissions are confirmed once the refund window closes.</p>
            </div>
          </details>
          <details class="group bg-card border border-border rounded-2xl">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-text pr-4">Who is this for?</h3>
              <svg class="w-5 h-5 text-text-secondary group-open:rotate-180 transition-transform flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-6 pb-6 text-text-secondary text-sm leading-relaxed">
              <p>Creators making couples, relationship, dating or lifestyle content — any size. We care more about how well your audience matches than follower count. Couples who create together are especially welcome.</p>
            </div>
          </details>
          <details class="group bg-card border border-border rounded-2xl">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-text pr-4">What are the rules?</h3>
              <svg class="w-5 h-5 text-text-secondary group-open:rotate-180 transition-transform flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-6 pb-6 text-text-secondary text-sm leading-relaxed">
              <p>Don't spam your code on coupon sites, no self-referrals. Commissions on refunded purchases are reversed. Stay active to keep your code live.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24 bg-gradient-radial">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <h2 class="tracking-tighter text-3xl md:text-5xl font-bold text-text mb-4">
          The first 20 spots won't last
        </h2>
        <p class="text-text-secondary mb-8">
          Apply with your handle and a couple of links — we answer within 48 hours.
        </p>
        <button
          type="button"
          class="apply-open btn-pink inline-flex items-center gap-2 px-7 py-3.5 rounded-xl font-semibold"
          data-cta-location="creators_bottom"
          data-fast-goal="cta_creators_apply"
        >
          Become a Founding Creator
        </button>
      </div>
    </section>
    <!-- Application modal — native <dialog> so Esc, focus trapping and the
         backdrop come for free. Submits to Supabase (same pattern as the
         existing lead-capture form). -->
    <!-- m-auto: Tailwind's preflight zeroes the UA `margin:auto` that centers a
         modal <dialog>, which otherwise pins it to the top-left. -->
    <dialog
      id="apply-dialog"
      class="m-auto w-[min(92vw,26rem)] rounded-3xl border border-border bg-card p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm"
    >
      <form id="apply-form" class="p-7" novalidate>
        <div class="flex items-start justify-between gap-4 mb-1">
          <h2 class="tracking-tighter text-2xl font-bold text-text">Apply as a creator</h2>
          <button
            type="button"
            id="apply-close"
            class="text-text-light hover:text-text transition-colors -mt-1 -mr-1 p-1"
            aria-label="Close"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <p class="text-text-secondary text-sm mb-6">
          Applying for <span id="apply-tier-label" class="font-semibold text-primary-dark">Founding Creator — 40%</span>.
          We answer within 48 hours.
        </p>

        <span class="block text-sm font-medium text-text mb-1.5">Platform</span>
        <!-- Radio group styled as icon tiles — a native <select> can't render
             icons. Brand glyphs are inline SVG (no external requests, CSP-safe). -->
        <div class="grid grid-cols-4 gap-2 mb-4" role="radiogroup" aria-label="Platform">
          <label class="platform-tile flex flex-col items-center gap-1.5 py-3 px-1 rounded-xl border border-border bg-background cursor-pointer transition-all hover:border-primary/40">
            <input type="radio" name="platform" value="TikTok" class="sr-only" checked />
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 1 1 .77-5.06V9.7a5.67 5.67 0 0 0-.77-.05A5.66 5.66 0 1 0 15.54 15.3V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-3.24-1.48Z"/></svg>
            <span class="text-[11px] font-medium leading-none">TikTok</span>
          </label>
          <label class="platform-tile flex flex-col items-center gap-1.5 py-3 px-1 rounded-xl border border-border bg-background cursor-pointer transition-all hover:border-primary/40">
            <input type="radio" name="platform" value="Instagram" class="sr-only" />
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
            <span class="text-[11px] font-medium leading-none">Instagram</span>
          </label>
          <label class="platform-tile flex flex-col items-center gap-1.5 py-3 px-1 rounded-xl border border-border bg-background cursor-pointer transition-all hover:border-primary/40">
            <input type="radio" name="platform" value="YouTube" class="sr-only" />
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.77-1.77C18.25 5 12 5 12 5s-6.25 0-7.83.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.77 1.77C5.75 19 12 19 12 19s6.25 0 7.83-.43a2.5 2.5 0 0 0 1.77-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3-5.2 3Z"/></svg>
            <span class="text-[11px] font-medium leading-none">YouTube</span>
          </label>
          <label class="platform-tile flex flex-col items-center gap-1.5 py-3 px-1 rounded-xl border border-border bg-background cursor-pointer transition-all hover:border-primary/40">
            <input type="radio" name="platform" value="Other" class="sr-only" />
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/></svg>
            <span class="text-[11px] font-medium leading-none">Other</span>
          </label>
        </div>

        <label class="block text-sm font-medium text-text mb-1.5" for="apply-handle">Your handle</label>
        <input
          id="apply-handle"
          name="handle"
          type="text"
          required
          placeholder="@yourhandle"
          autocomplete="off"
          class="w-full px-4 py-3 mb-4 rounded-xl border border-border bg-background text-text placeholder:text-text-light focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all"
        />

        <label class="block text-sm font-medium text-text mb-1.5" for="apply-email">
          Email <span class="text-text-light font-normal">(optional)</span>
        </label>
        <input
          id="apply-email"
          name="email"
          type="email"
          placeholder="you@example.com"
          autocomplete="email"
          class="w-full px-4 py-3 rounded-xl border border-border bg-background text-text placeholder:text-text-light focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all"
        />
        <p class="text-text-light text-xs mt-1.5 mb-6">
          Leave it if you'd rather we reply by email than by DM.
        </p>

        <button type="submit" id="apply-submit" class="btn-pink w-full px-6 py-3.5 rounded-xl font-semibold">
          Send application
        </button>
        <p id="apply-error" class="hidden text-sm text-center mt-3" style="color:#EC3639"></p>
      </form>

      <!-- Success state -->
      <div id="apply-success" class="hidden p-7 text-center">
        <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-primary-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <h2 class="tracking-tighter text-2xl font-bold text-text mb-2">Application sent</h2>
        <p class="text-text-secondary text-sm mb-6">
          We'll get back to you within 48 hours — by DM, or by email if you left one.
        </p>
        <button type="button" class="apply-close-btn btn-pink px-6 py-3 rounded-xl font-semibold">Done</button>
      </div>
    </dialog>
  </main>

  <Footer />

  <style>
    /* The radio itself is visually hidden, so the tile carries the state. */
    .platform-tile:has(input:checked) {
      border-color: var(--color-primary);
      background-color: color-mix(in srgb, var(--color-primary) 10%, transparent);
      color: var(--color-primary-dark);
    }
    .platform-tile:has(input:focus-visible) {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
  </style>

  <script define:vars={{
    SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL,
    SUPABASE_ANON_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  }}>
    // --- Tier selection: drives the CTA label and what the modal submits ---
    const cards = document.querySelectorAll('.tier-card');
    const ctaLabel = document.getElementById('apply-cta-label');
    const tierLabel = document.getElementById('apply-tier-label');
    let selected = { tier: 'Founding Creator', rate: '40' };

    const select = (card) => {
      cards.forEach((c) => {
        const active = c === card;
        c.setAttribute('aria-pressed', String(active));
        c.classList.toggle('ring-2', active);
        c.classList.toggle('ring-primary', active);
      });
      selected = { tier: card.dataset.tier || 'Creator', rate: card.dataset.rate || '' };
      if (ctaLabel) ctaLabel.textContent = `Apply — earn ${selected.rate}% per subscriber`;
      if (tierLabel) tierLabel.textContent = `${selected.tier} — ${selected.rate}%`;
    };

    // Locked tiers aren't selectable — the live offer stays on the CTA.
    cards.forEach((card) => {
      if (card.dataset.locked === 'true') return;
      card.addEventListener('click', () => select(card));
    });
    if (cards[0]) select(cards[0]); // default = Founding 40%

    // --- Modal ---
    const dialog = document.getElementById('apply-dialog');
    const form = document.getElementById('apply-form');
    const success = document.getElementById('apply-success');
    const errorEl = document.getElementById('apply-error');
    const submitBtn = document.getElementById('apply-submit');

    const openDialog = () => {
      form.classList.remove('hidden');
      success.classList.add('hidden');
      errorEl.classList.add('hidden');
      dialog.showModal();
      document.getElementById('apply-handle')?.focus();
    };
    const closeDialog = () => dialog.close();

    document.querySelectorAll('.apply-open').forEach((b) => b.addEventListener('click', openDialog));
    document.getElementById('apply-close')?.addEventListener('click', closeDialog);
    document.querySelectorAll('.apply-close-btn').forEach((b) => b.addEventListener('click', closeDialog));
    // Click on the backdrop (outside the form) closes too.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) closeDialog(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const platform = form.platform.value;
      const handle = form.handle.value.trim();
      const email = form.email.value.trim().toLowerCase();

      if (!handle) {
        errorEl.textContent = 'Please add your handle.';
        errorEl.classList.remove('hidden');
        return;
      }

      errorEl.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/creator_applications`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({
            platform,
            handle,
            email: email || null,
            tier: selected.tier,
            rate: Number(selected.rate),
          }),
        });
        if (!res.ok) {
          // Surface PostgREST's actual message — a bare status hides the cause
          // (constraint violation, RLS denial, trigger exception…).
          const detail = await res.text().catch(() => '');
          throw new Error(`HTTP ${res.status} ${detail}`);
        }

        if (window.posthog) {
          window.posthog.capture('creator_application_submitted', {
            platform, tier: selected.tier, rate: selected.rate, has_email: Boolean(email),
          });
        }
        if (window.datafast) window.datafast('creator_application_submitted');

        form.classList.add('hidden');
        success.classList.remove('hidden');
      } catch (err) {
        console.error('Creator application error:', err);
        errorEl.textContent = "Couldn't send — please retry, or DM us on Instagram.";
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send application';
      }
    });
  </script>
</Layout>
