---
// Shared analytics scripts: DataFast + PostHog.
//
// DataFast loads IMMEDIATELY; PostHog stays lazy. This split is deliberate.
//
// Both used to sit behind requestIdleCallback(…, {timeout: 4000}), which meant
// the pageview only fired once the browser went idle — up to 4s after paint,
// plus the script download on top. With a ~79% mobile bounce rate most visitors
// were gone before that, and DataFast was recording ~40% of the traffic GSC
// reported (1030 visitors vs 2518 Google clicks over the same 28 days).
//
// Worse than the volume loss: the surviving sample was BIASED toward visitors
// who stayed 4+ seconds, so every conversion rate measured off it read high.
//
// DataFast's script is ~1KB and already `defer`, so it never blocks parsing or
// rendering — there is no Core Web Vitals reason to delay it. PostHog is the
// heavy one (bundled dependency, session recording surface), so it keeps the
// idle/interaction gate.
---

<script>
  // @ts-nocheck
  // --- DataFast: immediate. `defer` keeps it off the critical path already. ---
  {
    const s = document.createElement('script');
    s.defer = true;
    s.dataset.websiteId = 'dfid_qI4dBMANAwmiNsJvVpicO';
    s.dataset.domain = 'ourcouple.app';
    s.src = 'https://datafa.st/js/script.js';
    document.head.appendChild(s);
  }

  // --- PostHog: lazy (heavy bundle, not needed for the pageview count). ---
  let loaded = false;

  const loadAll = async () => {
    if (loaded) return;
    loaded = true;
    const { default: posthog } = await import('posthog-js');
    posthog.init('phc_2ZAsUSvL9xkYDQjpB430ApXZ0HLkW7rbRf5PLFdBYGp', {
      api_host: 'https://eu.i.posthog.com',
      person_profiles: 'identified_only',
      capture_pageview: true,
      // Session replay off. It was enabled project-side (not in this config), so
      // it had to be turned off HERE to leave the mobile app's own PostHog
      // untouched — every recording in the project was `snapshot_source: web`,
      // i.e. all of it came from this site.
      //
      // Sampled 20 recordings over 30 days on 2026-08-18: `viewed: false` on
      // every one. Nothing was ever watched, so the only thing replay bought us
      // was console-error visibility.
      //
      // CAVEAT: that visibility is now gone and NOT replaced. Error tracking is
      // empty for this project (exceptions aren't captured), so the console
      // errors replay was showing — 77, 51 and 34 in single sessions on
      // /tools/truth-or-dare-couples — are no longer observable anywhere.
      // Adding `capture_exceptions: true` would restore it for a tiny fraction
      // of replay's cost; left off here because it wasn't asked for.
      disable_session_recording: true,
    });
    window.posthog = posthog;
  };

  const events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
  const onInteract = () => {
    events.forEach((e) => window.removeEventListener(e, onInteract));
    loadAll();
  };
  events.forEach((e) => window.addEventListener(e, onInteract, { once: true, passive: true }));

  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadAll, { timeout: 4000 });
  } else {
    setTimeout(loadAll, 3000);
  }

  // Track every App Store CTA click site-wide (delegated → fires on EVERY page,
  // not just the homepage). Records the real pathname + which CTA fired, so
  // blog/tool CTAs are no longer invisible in PostHog. Replaces the old
  // homepage-only listener that made `page` always "/".
  document.addEventListener('click', (e) => {
    // Match BOTH stores — this used to be App Store only, so every Google Play
    // click was invisible in PostHog once Android shipped.
    const link = e.target.closest &&
      e.target.closest('a[href*="apps.apple.com"], a[href*="play.google.com"]');
    if (!link) return;
    const isPlay = link.href.includes('play.google.com');
    const props = {
      cta: isPlay ? 'play_store' : 'app_store',
      store: link.dataset.ctaStore || (isPlay ? 'android' : 'ios'),
      page: window.location.pathname,
      location: link.dataset.ctaLocation || 'unknown',
    };
    // A CTA click can BE the first interaction, in which case PostHog hasn't
    // loaded yet and a bare `if (window.posthog)` silently dropped the event —
    // exactly the highest-value clicks. Await the loader, then capture.
    // (DataFast needs nothing here: it loads on paint and reads data-fast-goal.)
    if (window.posthog) {
      window.posthog.capture('website_cta_clicked', props);
    } else {
      loadAll().then(() => window.posthog?.capture('website_cta_clicked', props));
    }
  }, { capture: true });
</script>
